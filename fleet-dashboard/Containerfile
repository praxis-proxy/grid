# syntax=docker/dockerfile:1

# Multi-stage build for the fleet dashboard: the React UI is built once and
# embedded into the Rust binary by its build script.
#
# Usage:
#   docker build -t grid-fleet-dashboard:latest -f fleet-dashboard/Containerfile .

# ------------------------------------------------------------------------------
# Stage 1: Web UI
# ------------------------------------------------------------------------------

FROM node:22-alpine AS web

WORKDIR /src

COPY fleet-dashboard/web/package.json fleet-dashboard/web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY fleet-dashboard/web/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

RUN apk add --no-cache musl-dev pkgconf make g++

WORKDIR /src

COPY . .
COPY --from=web /src/dist ./fleet-dashboard/webui/dist

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p fleet-dashboard --bin fleet-dashboard \
    && cp target/release/fleet-dashboard /usr/local/bin/fleet-dashboard

# ------------------------------------------------------------------------------
# Stage 3: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid fleet dashboard: hub web UI for site health" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/fleet-dashboard /usr/local/bin/fleet-dashboard

USER 100:101

EXPOSE 8080

ENTRYPOINT ["fleet-dashboard"]
