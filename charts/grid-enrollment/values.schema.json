{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "enum": [true, false, "true", "false", "auto"],
          "description": "auto renders the Route when route.openshift.io/v1 is served."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
          "description": "DNS-1123 subdomain, no wildcard: it becomes a serving cert SAN."
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "concurrentTcp": { "type": "integer", "minimum": 1 },
            "rateTcp": { "type": "integer", "minimum": 1 }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "termination": { "enum": ["passthrough", "reencrypt"] },
            "insecureEdgeTerminationPolicy": { "enum": ["None", "Redirect", "Allow", ""] }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": { "type": "string" }
      }
    },
    "ca": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["builtin", "provided"] },
        "commonName": { "type": "string" },
        "keySecretName": { "type": "string" },
        "bundleSecretName": { "type": "string" },
        "forceRegenerate": { "type": "boolean" },
        "provided": {
          "type": "object",
          "properties": { "keySecretRef": { "type": "string" } }
        }
      },
      "required": ["method", "commonName", "keySecretName", "bundleSecretName"]
    },
    "serving": {
      "type": "object",
      "properties": {
        "secretName": { "type": "string" },
        "existingSecretRef": { "type": "string" },
        "extraDnsNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "enrollment": {
      "type": "object",
      "properties": {
        "authz": { "type": "string", "enum": ["local", "kube"] },
        "gridAdmins": {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "name"],
                "properties": {
                  "kind": { "type": "string", "enum": ["User", "Group", "ServiceAccount"] },
                  "name": { "type": "string", "minLength": 1, "not": { "pattern": "^system:(masters|authenticated|unauthenticated|serviceaccounts)(:.*)?$" } },
                  "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" }
                },
                "additionalProperties": false
              }
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" }
              }
            }
          }
        },
        "tokenAudience": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$",
          "not": {
            "enum": [
              "kubernetes",
              "https://kubernetes.default.svc",
              "https://kubernetes.default.svc/",
              "https://kubernetes.default.svc.cluster.local",
              "https://kubernetes.default.svc.cluster.local/"
            ]
          }
        },
        "listenAddr": { "type": "string" }
      }
    },
    "db": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["builtin", "external"] },
        "builtin": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "imageDigest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "connectionUrlSecretRef": { "type": "string" },
            "connectionUrlSecretKey": { "type": "string" }
          }
        }
      },
      "required": ["type"],
      "if": { "properties": { "type": { "const": "external" } } },
      "then": {
        "properties": {
          "external": {
            "properties": {
              "connectionUrlSecretRef": { "type": "string", "minLength": 1 }
            },
            "required": ["connectionUrlSecretRef"]
          }
        }
      }
    },
    "invites": {
      "type": "array",
      "description": "Site invites minted after install or upgrade into Secrets grid-invite-<siteName>.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siteName", "gridNetworkRef"],
        "properties": {
          "siteName": {
            "type": "string",
            "description": "Site name the token pins, a DNS label short enough for the Secret name.",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?$"
          },
          "gridNetworkRef": { "type": "string", "minLength": 1 },
          "expiresInSecs": { "type": "integer", "minimum": 1, "maximum": 604800 }
        }
      }
    }
  },
  "required": ["image", "ca", "serving", "enrollment", "db"]
}
