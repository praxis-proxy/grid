{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Subchart toggle set by a parent chart's dependency condition."
    },
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "site": {
      "description": "This site. name defaults swim.siteName.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Site name, a DNS label.",
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "region": {
          "description": "Deployment region.",
          "type": "string"
        },
        "zone": {
          "description": "Availability zone.",
          "type": "string"
        }
      }
    },
    "grid": {
      "description": "The grid this site joins. Setting id renders the GridNetwork and this site's GridSite.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "description": "GridNetwork name.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "id": {
          "description": "Grid identifier. Empty renders no GridNetwork or GridSite.",
          "type": "string"
        },
        "peerTrust": {
          "description": "Peer trust, pin or spiffe. Empty keeps the GridNetwork default.",
          "type": "string",
          "enum": [
            "",
            "pin",
            "spiffe"
          ]
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "description": "Where this site learns its members: Swim, or Local, where this site's configuration lists its peers as GridSites polled at their derived signals endpoints.",
              "type": "string",
              "enum": [
                "Swim",
                "Local"
              ]
            }
          }
        },
        "signedState": {
          "description": "Signed state on the rendered GridNetwork. Enforce requires grid.id; empty keeps the GridNetwork default.",
          "type": "string",
          "enum": [
            "",
            "off",
            "enforce"
          ]
        },
        "signals": {
          "description": "Signal transport, gossip or poll. Empty keeps the GridNetwork default.",
          "type": "string",
          "enum": [
            "",
            "gossip",
            "poll"
          ]
        },
        "seeds": {
          "description": "SWIM seed endpoints, a list or one string separated by spaces or commas. A bare host or address gets swim.service.port. Defaults swim.seeds.",
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "swimKeySecretName": {
          "description": "Secret holding the grid's SWIM key. Empty runs SWIM without one.",
          "type": "string"
        },
        "providers": {
          "description": "InferenceProviders keyed by name, as in the grid-site chart.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install and upgrade the Grid CRDs. Set false when the platform owns them."
        },
        "keep": {
          "type": "boolean",
          "description": "Keep the CRDs on helm uninstall and an Argo CD delete or prune."
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of operator replicas. One holds the operator lease and runs everything that writes."
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "description": "PodDisruptionBudget for the operator pods.",
      "properties": {
        "enabled": {
          "enum": [
            "auto",
            true,
            false
          ],
          "description": "auto renders one when replicaCount is above 1; true or false forces it."
        },
        "minAvailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^([0-9]+%?)?$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pods that must stay up, a count or a percentage."
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^([0-9]+%?)?$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pods that may be down at once, a count or a percentage."
        }
      }
    },
    "shutdownDelaySeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Seconds of preStop sleep before the operator stands down. Empty: none."
    },
    "terminationGracePeriodSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Seconds Kubernetes gives a terminating pod. Empty: 30 plus shutdownDelaySeconds."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Container image repository."
        },
        "tag": {
          "type": "string",
          "description": "Image tag. Defaults to the chart appVersion when empty."
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Immutable image digest. When set, the tag is ignored."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "description": "Image pull policy."
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "description": "Image pull secrets for private registries."
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name used in resource names."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the fully qualified app name."
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Labels added to all resources."
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Labels added to the operator pod template."
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Annotations added to the operator pod template."
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a ServiceAccount for the operator."
        },
        "name": {
          "type": "string",
          "description": "ServiceAccount name. Defaults to the fullname."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations on the ServiceAccount (e.g. for IAM role binding)."
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create ClusterRoles, ClusterRoleBindings, and RoleBindings."
        },
        "enrollmentNamespace": {
          "type": "string",
          "description": "The grid-enrollment namespace, which the render refuses to grant Secret access in."
        },
        "metricsScraper": {
          "type": "boolean",
          "description": "Create the metrics scraper ServiceAccount (get on /metrics only) and let the operator mint its tokens."
        }
      }
    },
    "resourceNamespaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional namespaces where the operator needs Secret, ConfigMap, Event, and Service access. The release namespace is always included."
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "description": "Level for every module: off, error, warn, info, debug, or trace, in any case. A full RUST_LOG directive is still accepted here for compatibility; prefer filter.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?i)(off|error|warn|info|debug|trace)$"
            },
            {
              "type": "string",
              "pattern": "[=,]"
            }
          ]
        },
        "filter": {
          "type": "string",
          "description": "Full RUST_LOG directive, such as info,operator=debug. When set, it replaces level."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindAddress": {
          "type": "string",
          "description": "Metrics and health server bind address."
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Create a ClusterIP Service for the metrics port."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Service port number."
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Annotations on the metrics Service."
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "false serves plaintext. auto and true serve TLS from metrics.tls.source.",
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "auto"
                  ]
                }
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "auto",
                "serviceCA",
                "siteIdentity",
                "existingSecret"
              ],
              "description": "Where the certificate comes from. auto picks one or fails the render."
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
              "description": "Secret holding tls.crt and tls.key."
            },
            "mountPath": {
              "type": "string",
              "minLength": 1,
              "description": "Mount path for the certificate and key."
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "auto, true, or false. auto turns it on where OpenShift runs.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "metricsFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          },
          "description": "NetworkPolicyPeer entries allowed to reach the metrics port."
        }
      }
    },
    "swim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindAddress": {
          "type": "string",
          "description": "SWIM protocol bind address."
        },
        "advertiseAddress": {
          "type": "string",
          "description": "Externally reachable SWIM advertise address. Defaults to the SWIM Service LoadBalancer address when that Service is a LoadBalancer, else Pod IP and bind port."
        },
        "requireKey": {
          "type": "boolean",
          "description": "Hold SWIM traffic until the GridNetwork key loads or the network declares none. false opts out."
        },
        "siteName": {
          "type": "string",
          "description": "Bootstrap SWIM site name override."
        },
        "seeds": {
          "type": "string",
          "description": "Bootstrap SWIM seed endpoints, separated by spaces or commas, as grid.seeds."
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Create a Service for the SWIM port."
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ],
              "description": "SWIM Service type."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "SWIM Service port."
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Annotations on the SWIM Service."
            },
            "loadBalancerIP": {
              "type": "string",
              "description": "Static IP for LoadBalancer type. Deprecated in Kubernetes, so prefer an annotation such as metallb.io/loadBalancerIPs."
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ],
              "description": "External traffic policy for LoadBalancer or NodePort Services."
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              },
              "description": "CIDRs allowed to reach the SWIM and signals LoadBalancer."
            }
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Serve the mTLS signals endpoint, expose it on the SWIM Service, and set GRID_SIGNALS_LOCAL_ADDR. For signalTransport poll."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Signals TCP port on the SWIM Service, gossiped to peers with its LoadBalancer address."
        },
        "advertiseAddress": {
          "type": "string",
          "description": "Signals endpoint gossiped to peers, ip:port, [ipv6]:port, or dns-name:port. Overrides the LoadBalancer discovery."
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Annotations on the SWIM Service."
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              },
              "description": "CIDRs allowed to reach the SWIM and signals LoadBalancer."
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ],
              "description": "External traffic policy for LoadBalancer or NodePort Services."
            },
            "loadBalancerIP": {
              "type": "string"
            }
          }
        },
        "maxHandshakesPerSource": {
          "description": "Concurrent handshakes one source address may hold. Empty keeps the operator default.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        },
        "peerEndpointPort": {
          "description": "Port each peer serves signals on, under Local membership, at its gateway endpoint's host. Empty dials the gateway's own port under <site>-signals.grid.internal.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        },
        "peerIntervalSeconds": {
          "description": "Seconds between peer signal polls, 1 to 99999. Every site polls every other alive site, so a grid of N sites makes N*(N-1) polls each interval. Empty keeps the operator default.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            {
              "type": "string",
              "pattern": "^$|^[1-9][0-9]{0,4}$"
            }
          ]
        },
        "scrapeIntervalSeconds": {
          "description": "Seconds between scrapes of this site's own EPPs, 1 to 99999. Local and unicast, so it costs one request per provider per interval. Empty keeps the operator default.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            {
              "type": "string",
              "pattern": "^$|^[1-9][0-9]{0,4}$"
            }
          ]
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "description": "An OpenShift Route in front of the signals Service.",
          "properties": {
            "enabled": {
              "description": "auto renders the Route where the cluster serves route.openshift.io/v1; true or false forces it.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "auto",
                    "true",
                    "false"
                  ]
                }
              ]
            },
            "host": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$",
              "description": "External hostname peers dial, the name the router matches the SNI against. No wildcard."
            },
            "annotations": {
              "type": "object",
              "description": "Extra Route annotations. They override rateLimit's on a key clash."
            },
            "rateLimit": {
              "type": "object",
              "additionalProperties": false,
              "description": "Per-source-IP connection limits in the router.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Render the rate-limit annotations."
                },
                "concurrentTcp": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Concurrent TCP connections per source IP."
                },
                "rateTcp": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "TCP connection rate per source IP, in the router's rate window."
                }
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "description": "Advertised gateway address override."
        },
        "serviceName": {
          "type": "string",
          "pattern": "^([a-z]([-a-z0-9]{0,61}[a-z0-9])?)?$",
          "description": "Gateway Kubernetes Service name for discovery; empty uses provider-gateway."
        },
        "namespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$",
          "description": "Namespace of the gateway Service; empty uses the release namespace."
        },
        "allowSystemNamespace": {
          "type": "boolean",
          "description": "Allow gateway.namespace to be default, kube-*, or openshift-*."
        },
        "port": {
          "type": "string",
          "description": "Gateway port for discovery."
        },
        "discoveryEnabled": {
          "type": "boolean",
          "description": "Discover and advertise a LoadBalancer address for the site gateway."
        },
        "praxisConfig": {
          "type": "object",
          "description": "GridNetwork consumerGateways[].praxisConfig for the site gateway, validated by the CRD."
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Liveness probe initial delay."
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Liveness probe period."
            }
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Period between startup probes."
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "description": "Failures allowed before restart."
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Readiness probe initial delay."
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Readiness probe period."
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a Prometheus ServiceMonitor."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional ServiceMonitor labels."
        },
        "namespace": {
          "type": "string",
          "description": "ServiceMonitor namespace override."
        },
        "interval": {
          "type": "string",
          "description": "Prometheus scrape interval."
        },
        "scrapeTimeout": {
          "type": "string",
          "description": "Prometheus scrape timeout."
        },
        "tlsConfig": {
          "type": "object",
          "description": "ServiceMonitor endpoint tlsConfig when metrics.tls is on."
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector for pod scheduling."
    },
    "affinity": {
      "type": "object",
      "description": "Pod affinity rules."
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Pod tolerations."
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Topology spread constraints."
    },
    "priorityClassName": {
      "type": "string",
      "description": "Priority class for the operator pod."
    },
    "operatorConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "This operator's own settings, a ConfigMap it watches.",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Render the ConfigMap."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
          "description": "ConfigMap name, in the release namespace."
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "description": "The operator config's site section: the site name, signerEndpoint with its rotation, and inviteSecretRef.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Name the signer and the invite, so the operator enrolls the site."
        },
        "url": {
          "type": "string",
          "pattern": "^(https://[^\\s]+)?$",
          "description": "Signer base URL (https), site.signerEndpoint.url."
        },
        "hub": {
          "type": "boolean",
          "description": "The grid-enrollment release runs on this cluster, so url defaults to its in-cluster Service."
        },
        "hubService": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$",
          "description": "With hub set and no url, the grid-enrollment release's full name."
        },
        "hubPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "With hub set and no url, the grid-enrollment Service's port."
        },
        "rotation": {
          "enum": [
            "",
            "Enabled",
            "Disabled"
          ],
          "description": "Whether the operator renews the site identity through the signer, site.signerEndpoint.rotation. Empty renders Disabled unless grid.peerTrust is spiffe."
        },
        "siteName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,49}[a-z0-9])?)?$",
          "description": "Site name the token pins, a DNS label of at most 51 characters."
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "description": "CA bundle that pins the signer to enroll, a Secret. ConfigMap bundles are refused.",
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
              "description": "Secret holding the bundle."
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Key holding the PEM bundle."
            }
          }
        },
        "gridCaBundle": {
          "type": "object",
          "additionalProperties": false,
          "description": "Grid CA the returned CA must match, a Secret.",
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
              "description": "Secret holding the bundle."
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Key holding the PEM bundle."
            }
          }
        },
        "identitySecretName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
          "description": "Identity Secret the rendered GridNetwork names."
        },
        "caSecretName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
          "description": "Grid CA Secret the rendered GridNetwork names."
        },
        "tokenSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secret holding the one-time site token.",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
              "description": "Secret name."
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "Key holding the token."
            }
          }
        },
        "signerHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s,/]+$"
          },
          "description": "Signer hosts, host or host:port, the operator config may name. Empty defaults to the host and port of enrollment.url."
        }
      }
    },
    "platform": {
      "type": "string",
      "enum": [
        "",
        "aws",
        "azure",
        "gcp",
        "any"
      ],
      "description": "Cloud whose load balancer settings LoadBalancer Services get: aws, azure, gcp, or any for all three, since each cloud reads only its own keys."
    },
    "loadBalancerScope": {
      "description": "Reach of the SWIM and signals load balancers on a cloud platform: internal (private network) or external (internet-facing).",
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "peers": {
      "description": "The grid's other sites, separated by spaces or commas: SWIM seeds unless a seed key is set, and host routes for the bare IPv4 addresses.",
      "type": "string"
    }
  }
}
