{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "issuer", "ca"],
  "properties": {
    "enabled": {"type": "boolean"},
    "global": {"type": "object"},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/definitions/name"}
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "secretName", "certificateName", "bootstrapIssuerName", "commonName", "durationHours", "renewBeforeHours"],
      "properties": {
        "mode": {"type": "string", "enum": ["Existing", "Generate"]},
        "secretName": {"$ref": "#/definitions/name"},
        "certificateName": {"$ref": "#/definitions/name"},
        "bootstrapIssuerName": {"$ref": "#/definitions/name"},
        "commonName": {"type": "string", "minLength": 1, "maxLength": 64},
        "durationHours": {"type": "integer", "minimum": 2, "maximum": 876000},
        "renewBeforeHours": {"type": "integer", "minimum": 1, "maximum": 875999}
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    }
  }
}
