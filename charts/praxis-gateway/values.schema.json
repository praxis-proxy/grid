{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["praxisConfig"],
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Subchart toggle set by a parent chart's dependency condition."
    },
    "global": {
      "type": "object",
      "description": "Global values Helm passes to every subchart."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "NetworkPolicy limiting ingress to the listener port.",
      "properties": {
        "enabled": { "type": "boolean" },
        "from": { "type": "array", "items": { "type": "object" } }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of gateway replicas."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Container image repository."
        },
        "tag": {
          "type": "string",
          "description": "Image tag. Defaults to the chart appVersion when empty."
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$",
          "description": "Immutable image digest. When set, the tag is ignored."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Image pull policy."
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" }
        },
        "required": ["name"]
      },
      "description": "Image pull secrets for private registries."
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the chart name used in resource names."
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the fully qualified app name."
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Labels added to all resources."
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Additional labels on the gateway pod template."
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Annotations on the gateway pod template."
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extra pod-level securityContext fields. Protected fields (runAsNonRoot, seccompProfile) are chart-owned.",
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0,
          "description": "UID for the pod."
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0,
          "description": "GID for the pod."
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0,
          "description": "Filesystem group ID for volume mounts."
        },
        "supplementalGroups": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "Additional group IDs."
        }
      }
    },
    "args": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Container arguments."
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "valueFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKeyRef"],
            "properties": {
              "secretKeyRef": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "key"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "key": { "type": "string", "minLength": 1 },
                  "optional": { "type": "boolean" }
                }
              }
            }
          }
        },
        "oneOf": [
          { "required": ["value"] },
          { "required": ["valueFrom"] }
        ]
      },
      "description": "Environment variables passed to the Praxis container."
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which GridNetwork and site this gateway belongs to.",
      "properties": {
        "networkName": { "type": "string", "description": "GridNetwork name. Used only by the overlay sidecar scope check." },
        "siteName": { "type": "string", "maxLength": 256, "description": "Site name. Used by render (local_site) and the overlay sidecar scope check." }
      }
    },
    "praxisConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "The gateway's praxis.yaml: who writes it and where it is.",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["byo", "operator", "render"],
          "description": "Who writes praxis.yaml: byo (you), operator (the Grid operator), or render (this chart, from praxisConfig.render)."
        },
        "configMapName": {
          "type": "string",
          "description": "Name of the ConfigMap containing praxis.yaml, for source byo or operator."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Key within the ConfigMap that holds praxis.yaml. Only for source byo."
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secure-by-default rendered gateway config (praxis.yaml + policy.yaml), used when source is render. Never emits insecure_options.",
          "properties": {
            "model": { "type": "string" },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "type": "string", "enum": ["", "none", "api-key"], "description": "Caller authentication, required when praxisConfig.source is render. api-key needs an image that registers identity/api-key." },
                "allowUnauthenticatedExposure": { "type": "boolean", "description": "With mode none, allow a LoadBalancer or NodePort Service." },
                "stripAuthorization": { "type": "boolean", "description": "Remove the caller's Authorization header before routing." },
                "validateCA": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "CA for the validate call, set as SSL_CERT_FILE (replaces the platform trust store).",
                  "properties": {
                    "configMapName": { "type": "string" },
                    "secretName": { "type": "string" },
                    "key": { "type": "string" },
                    "mountPath": { "type": "string" }
                  }
                },
                "validateUrl": { "type": "string", "pattern": "^(https://[^/?#\\s]+.*)?$" },
                "allowPrivateEndpoint": { "type": "boolean", "description": "Sets allow_private_idp: every policy callout may reach private, loopback, and link-local addresses." },
                "prefix": { "type": "string" },
                "timeoutSecs": { "type": "integer" }
              }
            },
            "backends": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cluster", "endpoints"],
                "properties": {
                  "cluster": { "type": "string", "minLength": 1, "pattern": "\\S" },
                  "endpoints": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\S+:[0-9]+$" } },
                  "healthCheck": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": { "enum": ["http", "tcp"] },
                      "path": { "type": "string" },
                      "intervalMs": { "type": "integer", "minimum": 1 },
                      "timeoutMs": { "type": "integer", "minimum": 1 },
                      "healthyThreshold": { "type": "integer", "minimum": 1 },
                      "unhealthyThreshold": { "type": "integer", "minimum": 1 }
                    }
                  },
                  "transport": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Upstream transport. Defaults to mutual_tls when gridIdentity.secretName is set, else plaintext.",
                    "properties": {
                      "mode": { "type": "string", "enum": ["mutual_tls", "tls", "plaintext"] },
                      "sni": { "type": "string" },
                      "ca": {
                        "type": "object",
                        "additionalProperties": false,
                        "description": "tls only: CA bundle that verifies this backend.",
                        "properties": {
                          "configMapName": { "type": "string" },
                          "secretName": { "type": "string" },
                          "key": { "type": "string" }
                        },
                        "oneOf": [
                          { "required": ["configMapName"], "properties": { "configMapName": { "minLength": 1 }, "secretName": { "maxLength": 0 } } },
                          { "required": ["secretName"], "properties": { "secretName": { "minLength": 1 }, "configMapName": { "maxLength": 0 } } }
                        ]
                      }
                    },
                    "if": { "required": ["ca"] },
                    "then": { "required": ["mode"], "properties": { "mode": { "const": "tls" } } }
                  }
                }
              }
            }

          }
        }
      }
    },
    "upstreamCA": {
      "type": "object",
      "additionalProperties": false,
      "description": "CA bundle for backend TLS (outbound). Set secretName to turn it on. render and byo; not operator.",
      "properties": {
        "secretName": { "type": "string" },
        "key": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    },
    "listenerTls": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server cert for TLS on the gateway listener (inbound). Set secretName to turn it on. render and byo; not operator.",
      "properties": {
        "secretName": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Container port number."
        },
        "name": {
          "type": "string",
          "description": "Port name. Empty: https when listenerTls.secretName is set, else http."
        },
        "protocol": {
          "type": "string",
          "enum": ["TCP", "UDP"],
          "description": "Port protocol."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a Service for the gateway."
        },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "LoadBalancer", "NodePort"],
          "description": "Service type."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Service annotations."
        },
        "loadBalancerIP": {
          "type": "string",
          "description": "Static IP for LoadBalancer type."
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMapName": {
          "type": "string",
          "description": "Name of the existing overlay ConfigMap. Set it to deliver the overlay through the overlay-sync sidecar; empty turns the overlay off."
        },
        "mountPath": {
          "type": "string",
          "description": "Mount path for overlay files."
        },
        "sidecar": {
          "type": "object",
          "additionalProperties": false,
          "description": "Overlay sync sidecar settings.",
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": { "type": "string", "description": "Sidecar image repository." },
                "tag": { "type": "string", "description": "Sidecar image tag." },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "description": "Sidecar image pull policy." }
              }
            },
            "dataKey": {
              "type": "string",
              "description": "ConfigMap data key containing the overlay envelope."
            },
            "resources": {
              "type": "object",
              "description": "Sidecar resource requests and limits."
            }
          }
        }
      }
    },
    "gridIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Existing Secret with the grid identity (tls.crt, tls.key, ca.crt). Set it to mount the Secret."
        },
        "mountPath": {
          "type": "string",
          "description": "Mount path for TLS files."
        }
      }
    },
    "providerCredentials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secretName"],
        "properties": {
          "secretName": {
            "type": "string",
            "minLength": 1,
            "description": "Existing Secret with the provider credential."
          },
          "mountPath": {
            "type": "string",
            "minLength": 1,
            "description": "Mount path. Defaults to /run/secrets/grid-credentials/<secretName>."
          },
          "optional": {
            "type": "boolean",
            "description": "Whether the Secret is optional."
          }
        }
      },
      "description": "Provider credential Secrets mounted into the gateway."
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "description": "Readiness probe settings. Null to disable."
        },
        "liveness": {
          "description": "Liveness probe settings. Null to disable."
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "Container resource requests and limits."
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Node selector for pod scheduling."
    },
    "affinity": {
      "type": "object",
      "description": "Pod affinity rules."
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Pod tolerations."
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Topology spread constraints."
    },
    "priorityClassName": {
      "type": "string",
      "description": "Priority class for the gateway pod."
    }
  }
}
