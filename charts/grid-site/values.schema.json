{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gridNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "allOf": [
        {
          "if": { "required": ["placementPolicy"] },
          "then": {
            "required": ["selectionPolicy"],
            "properties": {
              "selectionPolicy": {
                "required": ["mode"],
                "properties": { "mode": { "const": "weightedRandom" } }
              }
            }
          }
        },
        {
          "if": {
            "required": ["selectionPolicy"],
            "properties": {
              "selectionPolicy": {
                "required": ["mode"],
                "properties": { "mode": { "const": "weightedRandom" } }
              }
            }
          },
          "then": { "required": ["placementPolicy"] }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gridId": {
          "type": "string"
        },
        "autoDiscoverSites": {
          "type": ["boolean", "null"],
          "description": "Create a GridSite for each SWIM peer and route to them."
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "seeds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "swim": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "probeInterval": { "type": "string" },
            "suspicionTimeout": { "type": "string" },
            "gossipNodes": { "type": "integer", "minimum": 1 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true
        },
        "routingPolicy": {
          "type": "string",
          "enum": ["geographyFirst", "scoreFirst"]
        },
        "scoringPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["noMetrics", "queueDepth", "kvCachePressure"]
            }
          }
        },
        "admissionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "pressure", "missingMetrics"],
          "properties": {
            "mode": { "type": "string", "enum": ["instantaneous", "stabilized"] },
            "missingMetrics": { "type": "string", "enum": ["existingOnly", "excluded"] },
            "pressure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enterThreshold", "exitThreshold", "failureThreshold", "successThreshold", "minimumStateDuration", "recoveryHoldDown"],
              "properties": {
                "enterThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
                "exitThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
                "successThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
                "minimumStateDuration": { "type": "string", "pattern": "^[1-9][0-9]*s$" },
                "recoveryHoldDown": { "type": "string", "pattern": "^[1-9][0-9]*s$" }
              }
            }
          }
        },
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["deterministic", "roundRobin", "random", "weightedRandom"]
            }
          }
        },
        "signalTransport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["gossip", "poll"]
            }
          }
        },
        "peerTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["pin", "spiffe"]
            }
          }
        },
        "placementPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["static"]
            }
          }
        },
        "metricsRefreshInterval": {
          "type": "string",
          "pattern": "^([1-9][0-9]*s|[1-9][0-9]{3,}ms)$"
        },
        "budgetPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantId", "capUsd"],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1 },
                  "capUsd": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "gatewayRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "namespace"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "localSiteName": { "type": "string" }
            }
          }
        }
      }
    },
    "gridSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "providerSiteLabel": {
          "type": "string"
        },
        "egress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "address": { "type": "string", "minLength": 1 },
            "tls": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "peers": {
      "type": "object",
      "description": "Remote sites this site trusts, keyed by site name, one GridSite each.",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "address": { "type": "string", "pattern": "^\\S+:[0-9]+$", "description": "Peer gateway host:port the operator probes." },
          "serverName": { "type": "string", "minLength": 1, "maxLength": 253, "description": "Name the probe verifies. Defaults to <name>.grid.internal." },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The peer's leaf certificate SHA-256 (DER)." },
          "nextDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The next leaf digest during a rotation." },
          "region": { "type": "string" },
          "zone": { "type": "string" }
        }
      }
    },
    "inferenceProviders": {
      "description": "InferenceProviders keyed by name, or the older list of full specs.",
      "oneOf": [
        { "type": "object", "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" }, "additionalProperties": {"type": "object", "additionalProperties": true, "required": ["endpoint"], "properties": {"name": {"type": "string", "minLength": 1}, "gridNetworkRef": {"type": "string", "minLength": 1}, "providerKind": {"type": "string", "minLength": 1}, "backendKind": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "minLength": 1}, "routingClusterRef": {"type": "string"}, "gatewayRef": {"type": "string", "minLength": 1}, "trafficPolicy": {"type": "object", "additionalProperties": false, "properties": {"drain": {"type": "boolean", "default": false}}}, "capacityWeight": {"type": "integer", "minimum": 1, "maximum": 1000}, "model": {"type": "string", "minLength": 1, "description": "Model name. Defaults to the key."}}} },
        { "type": "array" }
      ],
      "type": ["array", "object"],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "gridNetworkRef", "providerKind", "backendKind", "endpoint"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "gridNetworkRef": { "type": "string", "minLength": 1 },
          "providerKind": { "type": "string", "minLength": 1 },
          "backendKind": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "routingClusterRef": { "type": "string" },
          "gatewayRef": { "type": "string", "minLength": 1 },
          "trafficPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "drain": { "type": "boolean", "default": false } }
          },
          "capacityWeight": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
