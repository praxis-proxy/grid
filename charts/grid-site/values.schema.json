{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gridNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gridId": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "seeds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "swim": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "probeInterval": { "type": "string" },
            "suspicionTimeout": { "type": "string" },
            "gossipNodes": { "type": "integer", "minimum": 1 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true
        },
        "routingPolicy": {
          "type": "string",
          "enum": ["geographyFirst", "scoreFirst"]
        },
        "scoringPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["noMetrics", "queueDepth", "kvCachePressure"]
            }
          }
        },
        "admissionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "pressure", "missingMetrics"],
          "properties": {
            "mode": { "type": "string", "enum": ["instantaneous", "stabilized"] },
            "missingMetrics": { "type": "string", "enum": ["existingOnly", "excluded"] },
            "pressure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enterThreshold", "exitThreshold", "failureThreshold", "successThreshold", "minimumStateDuration", "recoveryHoldDown"],
              "properties": {
                "enterThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
                "exitThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
                "successThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
                "minimumStateDuration": { "type": "string", "pattern": "^[1-9][0-9]*s$" },
                "recoveryHoldDown": { "type": "string", "pattern": "^[1-9][0-9]*s$" }
              }
            }
          }
        },
        "selectionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["deterministic", "roundRobin", "random"]
            }
          }
        },
        "metricsRefreshInterval": {
          "type": "string",
          "pattern": "^([1-9][0-9]*s|[1-9][0-9]{3,}ms)$"
        },
        "budgetPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantId", "capUsd"],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1 },
                  "capUsd": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "gatewayRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "namespace"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "localSiteName": { "type": "string" }
            }
          }
        }
      }
    },
    "gridSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "providerSiteLabel": {
          "type": "string"
        },
        "egress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "address": { "type": "string", "minLength": 1 },
            "tls": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "inferenceProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "gridNetworkRef", "providerKind", "backendKind", "endpoint"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "gridNetworkRef": { "type": "string", "minLength": 1 },
          "providerKind": { "type": "string", "minLength": 1 },
          "backendKind": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "routingClusterRef": { "type": "string" }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
