# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

# ------------------------------------------------------------------------------
# Cache Build
# ------------------------------------------------------------------------------

COPY Cargo.toml Cargo.lock ./
COPY overlay-sync/Cargo.toml overlay-sync/Cargo.toml

# Strip workspace members not needed for this binary.
RUN sed -i '/certs/d; /crdt/d; /enrollment/d; /forge/d; /mock-providers/d; /operator/d; /scoring/d; /swim/d; /xtask/d' Cargo.toml

RUN mkdir -p overlay-sync/src \
    && printf '//! stub\nfn main() {}\n' > overlay-sync/src/main.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p grid-overlay-sync --bin grid-overlay-sync

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------

COPY overlay-sync/src overlay-sync/src
COPY tests/fixtures tests/fixtures

RUN find overlay-sync/src -name '*.rs' -exec touch {} +

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p grid-overlay-sync --bin grid-overlay-sync \
    && cp target/release/grid-overlay-sync /usr/local/bin/grid-overlay-sync

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid overlay sync sidecar" \
    org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/grid-overlay-sync /usr/local/bin/grid-overlay-sync

USER 100:101

EXPOSE 9091

ENTRYPOINT ["grid-overlay-sync"]
