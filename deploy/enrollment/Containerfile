# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------
#
# Copy workspace manifests first, build with stub sources to cache dependency
# compilation, then copy real source and rebuild only project crates.

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

# ------------------------------------------------------------------------------
# Cache Build
# ------------------------------------------------------------------------------

COPY Cargo.toml Cargo.lock ./
COPY enrollment/Cargo.toml enrollment/Cargo.toml
COPY certs/Cargo.toml certs/Cargo.toml

# Strip workspace members this binary does not need. certs stays: it signs.
RUN sed -i '/"crdt"/d; /"forge"/d; /"mock-providers"/d; /"operator"/d; /"overlay-sync"/d; /"scoring"/d; /"swim"/d; /"xtask"/d' Cargo.toml

RUN mkdir -p enrollment/src certs/src \
    && printf '//! stub\nfn main() {}\n' > enrollment/src/main.rs \
    && printf '//! stub\n' > enrollment/src/lib.rs \
    && printf '//! stub\n' > certs/src/lib.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment || true

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------

COPY certs/src certs/src
COPY enrollment/src enrollment/src
COPY enrollment/db enrollment/db

RUN find certs/src enrollment/src -name '*.rs' -exec touch {} +

# Built without the sar feature, so this is the standalone local-token image.
# ENROLLMENT_AUTHZ=kube needs a separate --features sar build that links the
# Kubernetes client. Keeping it out here matches the service's Kubernetes-free
# default and keeps the image small.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment --bin enrollment \
    && cp target/release/enrollment /usr/local/bin/enrollment

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid enrollment service" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/enrollment /usr/local/bin/enrollment

USER 100:101

EXPOSE 8080

ENTRYPOINT ["enrollment"]
