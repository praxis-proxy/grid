# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------
#
# Builds the enrollment binary, which serves the enrollment API and also runs
# the pre-install `enrollment bootstrap` Job (CA + serving cert + Secrets).
#
# Whole-tree COPY (scoped by .dockerignore) rather than a per-crate manifest
# list, so a new workspace member cannot silently break the build.

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

# Both features are needed and independent: sar builds the Kubernetes-RBAC
# authorizer (the ENROLLMENT_AUTHZ=kube default), bootstrap builds the
# `enrollment bootstrap` subcommand. Each pulls the kube client.
ARG CARGO_FEATURES="sar,bootstrap"

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment --bin enrollment \
        --features "${CARGO_FEATURES}" \
    && cp target/release/enrollment /usr/local/bin/enrollment

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid enrollment service" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/enrollment /usr/local/bin/enrollment

USER 100:101

# TLS enrollment endpoint (see charts/grid-enrollment values enrollment.listenAddr).
EXPOSE 8443/tcp

ENTRYPOINT ["enrollment"]
