# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------
#
# Copy workspace manifests first, build with a stub source to cache dependency
# compilation, then copy real source and rebuild only the gateway crate.

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

# ------------------------------------------------------------------------------
# Cache Build
# ------------------------------------------------------------------------------

COPY Cargo.toml Cargo.lock ./

# Copy Cargo.toml for every workspace member so cargo can resolve the workspace.
# Only gateway needs full source; the rest are manifest-only stubs.
COPY certs/Cargo.toml certs/Cargo.toml
COPY common/Cargo.toml common/Cargo.toml
COPY crdt/Cargo.toml crdt/Cargo.toml
COPY enrollment/Cargo.toml enrollment/Cargo.toml
COPY filter/Cargo.toml filter/Cargo.toml
COPY forge/Cargo.toml forge/Cargo.toml
COPY gateway/Cargo.toml gateway/Cargo.toml
COPY mock-providers/Cargo.toml mock-providers/Cargo.toml
COPY operator/Cargo.toml operator/Cargo.toml
COPY overlay-sync/Cargo.toml overlay-sync/Cargo.toml
COPY scoring/Cargo.toml scoring/Cargo.toml
COPY swim/Cargo.toml swim/Cargo.toml
COPY xtask/Cargo.toml xtask/Cargo.toml

# Create stub sources so cargo can validate each workspace member manifest
# without compiling them. Only gateway is actually built.
RUN mkdir -p certs/src common/src crdt/src filter/src forge/src operator/src \
             scoring/src swim/src overlay-sync/src mock-providers/src xtask/src \
             gateway/src \
    && touch certs/src/lib.rs common/src/lib.rs crdt/src/lib.rs filter/src/lib.rs \
             forge/src/lib.rs operator/src/lib.rs scoring/src/lib.rs swim/src/lib.rs \
    && printf 'fn main() {}\n' > overlay-sync/src/main.rs \
    && printf 'fn main() {}\n' > mock-providers/src/main.rs \
    && printf 'fn main() {}\n' > xtask/src/main.rs \
    && printf '//! stub\nfn main() {}\n' > gateway/src/main.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p gateway --bin grid-gateway

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------

COPY gateway/src gateway/src

RUN find gateway/src -name '*.rs' -exec touch {} +

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p gateway --bin grid-gateway \
    && cp target/release/grid-gateway /usr/local/bin/grid-gateway

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Praxis-based grid data-plane gateway" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/grid-gateway /usr/local/bin/grid-gateway

USER 100:101

ENTRYPOINT ["grid-gateway"]
