# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

# Static OpenSSL for the musl target: the gateway's deps pull openssl-sys.
ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

COPY . .

# gateway is its own workspace (own Cargo.toml/lock), not a root member, so build
# through its manifest, which resolves gateway/Cargo.lock.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/gateway/target \
    cargo build --release --manifest-path gateway/Cargo.toml --bin grid-gateway \
    && cp gateway/target/release/grid-gateway /usr/local/bin/grid-gateway

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Praxis-based grid data-plane gateway" \
    org.opencontainers.image.licenses="Apache-2.0"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/grid-gateway /usr/local/bin/grid-gateway

USER 100:101

ENTRYPOINT ["grid-gateway"]
